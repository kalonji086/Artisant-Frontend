{
  "expo": {
    "name": "Artisants",
    "slug": "Artisant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "artisant",
    "userInterfaceStyle": "automatic",
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.artisants.app",
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Artisant utilise votre position pour trouver les artisans les plus proches."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 150
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": "Artisants utilise la caméra pour prendre votre photo de profil.",
          "photosPermission": "Artisants accède à vos photos pour choisir votre photo de profil."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "description": "Trouvez les artisans les plus proches de chez vous.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09a6e4cb-93cb-4525-b436-708df598e470"
      }
    },
    "owner": "zuwandakus-team"
  }
}
